{
  "info": {
    "_postman_id": "658c49d3-e274-4618-8a95-546de8cfb048",
    "name": "AfterClass API Tests",
    "description": "GET /lessons, static images, POST /orders and PUT /lessons/:_id for the AfterClass Express server. Uses the base_url environment variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /lessons",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns an array of at least 3 lessons\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an(\"array\");",
              "    pm.expect(json.length).to.be.at.least(3);",
              "});",
              "pm.test(\"Each lesson has subject, location, price and availability\", function () {",
              "    pm.response.json().forEach(function (lesson) {",
              "        pm.expect(lesson).to.have.all.keys(\"_id\", \"id\", \"subject\", \"location\", \"price\", \"availability\", \"image\", \"alt\");",
              "    });",
              "});",
              "pm.test(\"A lesson is located in Hendon\", function () {",
              "    var locations = pm.response.json().map(function (lesson) { return lesson.location; });",
              "    pm.expect(locations).to.include(\"Hendon\");",
              "});",
              "// Save the first lesson _id so the PUT request can use it",
              "pm.environment.set(\"lesson_id\", pm.response.json()[0]._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/lessons",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "lessons"
          ]
        }
      }
    },
    {
      "name": "GET /images/math.svg (static file)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type is an image\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"image\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/images/math.svg",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "images",
            "math.svg"
          ]
        }
      }
    },
    {
      "name": "GET /images/missing.jpg (image not found)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Error message is returned\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Image not found\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/images/missing.jpg",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "images",
            "missing.jpg"
          ]
        }
      }
    },
    {
      "name": "POST /orders",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has acknowledged true\", function () {",
              "    pm.expect(pm.response.json().acknowledged).to.equal(true);",
              "});",
              "pm.test(\"Response has an insertedId\", function () {",
              "    pm.expect(pm.response.json().insertedId).to.be.a(\"string\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test\",\n  \"phone\": \"01234555555\",\n  \"lessonIDs\": [\n    1001,\n    1002\n  ],\n  \"spaces\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PUT /lessons/:_id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has acknowledged true\", function () {",
              "    pm.expect(pm.response.json().acknowledged).to.equal(true);",
              "});",
              "pm.test(\"One lesson matched\", function () {",
              "    pm.expect(pm.response.json().matchedCount).to.equal(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/lessons/{{lesson_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "lessons",
            "{{lesson_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"availability\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}